# Application settings
APP_NAME=AI-PLT-AGENTS
APP_VERSION=0.1.0
APP_DESCRIPTION=AI Platform Agents Service
APP_ENV=development

# Logging settings
LOGGING_LEVEL=INFO
LOGGING_JSON_FORMAT_ENABLED=false

# Endpoint settings
ENDPOINT_HOST=0.0.0.0
ENDPOINT_PORT=8002

# Google Cloud Vertex AI & Gemini settings
GCP_PROJECT_ID=
GCP_LOCATION=
GEMINI_MODEL=
GEMINI_TEMPERATURE=
GEMINI_MAX_TOKENS=

# MCP Registry Gateway settings
MCP_REGISTRY_URL=http://localhost:8081/sse
MCP_TIMEOUT_SECONDS=60

# Local LLM Instance settings (vLLM / Compute Engine / Ollama)
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT_SECONDS=60
LOCAL_LLM_TEMPERATURE=0.7
LOCAL_LLM_MAX_TOKENS=4096
LOCAL_LLM_ENABLED=true

# Smart AI Router settings
ROUTER_DEFAULT_STRATEGY=AUTO
ROUTER_COMPLEXITY_THRESHOLD=0.55
ROUTER_FALLBACK_ENABLED=true
